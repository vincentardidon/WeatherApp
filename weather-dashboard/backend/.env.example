PORT=5000
NODE_ENV=development

# Maximum time (milliseconds) to wait for each Open-Meteo request.
UPSTREAM_TIMEOUT_MS=6000

# Maximum time (milliseconds) for the whole request/response cycle.
REQUEST_TIMEOUT_MS=10000

# Open-Meteo is free for non-commercial use and needs NO key.
# Only fill this in if you buy a commercial plan. Never commit the real value.
OPEN_METEO_API_KEY=